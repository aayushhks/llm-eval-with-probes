# Production image. Build from the repo root:
#   docker build -f backend/Dockerfile.prod .
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# The repo layout is load-bearing: loader.py and config.py resolve paths via
# parents[3], so backend/ has to sit one level below the repo root in here too.
WORKDIR /srv/backend

# Deps first so they cache independently of source changes. The project has no
# [build-system], so uv treats it as virtual and installs deps only.
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini

# Included so evals can be run on the box to seed the dashboard (--no-probes;
# the MLX probes are Apple Silicon only and import lazily).
COPY scripts /srv/scripts
COPY datasets /srv/datasets

COPY deploy/backend-entrypoint.sh /usr/local/bin/backend-entrypoint.sh
RUN chmod +x /usr/local/bin/backend-entrypoint.sh

ENV PYTHONPATH=/srv/backend \
    PYTHONUNBUFFERED=1 \
    PATH="/srv/backend/.venv/bin:$PATH"

EXPOSE 8000
ENTRYPOINT ["backend-entrypoint.sh"]

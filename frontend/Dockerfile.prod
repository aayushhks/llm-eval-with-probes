# Builds the React app and bakes it into Caddy, which also fronts the API.
# Build from the repo root:
#   docker build -f frontend/Dockerfile.prod .
FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
# Caddyfile is bind-mounted at runtime so the domain can change without a rebuild.
COPY --from=build /app/dist /srv

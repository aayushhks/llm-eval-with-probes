# Copy to .env on the server: cp .env.prod.example .env
# .env is gitignored — never commit the filled-in version.

# Postgres. Generate the password with: openssl rand -base64 32
POSTGRES_USER=eval
POSTGRES_PASSWORD=
POSTGRES_DB=eval

# ":80" serves plain HTTP on the instance's public IP — fine to start with.
# Set to a bare domain (e.g. eval.example.com) and Caddy handles TLS for you.
SITE_ADDRESS=:80

# Only needed if you run evals on the server. The dashboard itself reads from
# Postgres and needs neither key.
GROQ_API_KEY=
GEMINI_API_KEY=

# Extra browser origins allowed to call the API, comma-separated. The bundled
# frontend is same-origin so it needs nothing here; add your Vercel URL only if
# you keep that deployment pointed at this API.
CORS_ALLOW_ORIGINS=

# 1 is right for a 1 GB t3.micro. Raise it on a bigger instance.
UVICORN_WORKERS=1
